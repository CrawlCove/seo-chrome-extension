{
  "manifest_version": 3,
  "name": "Crawl Cove SEO Checker + AI Visibility",
  "short_name": "Crawl Cove",
  "version": "1.1.0",
  "description": "On-page SEO checker with an AI visibility report: metas, headings, schema, links, vitals, keyword, which AI crawlers can read it.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "Check this page with Crawl Cove",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "homepage_url": "https://crawlcove.com/?utm_source=chrome&utm_medium=seo-chrome-extension",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Check this page with Crawl Cove"
    }
  }
}
